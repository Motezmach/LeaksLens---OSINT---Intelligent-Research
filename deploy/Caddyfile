# Caddy reverse proxy for the LeakLens backend on a VPS.
# Provides automatic TLS (Let's Encrypt) and forwards API traffic to the backend.
#
# One VPS can host MULTIPLE projects: give each its own subdomain block below.
# Caddy routes by hostname and gets a separate certificate for each. Point an
# A record for every subdomain at this VPS's IP.

api.leaklens.example.com {
	encode zstd gzip

	# Security headers (defense in depth; backend also sets these).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy backend:8000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# ---------------------------------------------------------------------------
# Example: a SECOND project on the same VPS (e.g. your vuln scanner backend).
# Uncomment, set the real subdomain, and point it at that project's container
# or host port. Each project keeps its own Docker Compose stack / port.
# ---------------------------------------------------------------------------
