# ---- Core ----
ENVIRONMENT=production
DEBUG=false
# Generate a strong key: openssl rand -hex 32
SECRET_KEY=

# ---- Database ----
POSTGRES_USER=leaklens
POSTGRES_PASSWORD=
POSTGRES_DB=leaklens

# ---- Registration gate ----
# When set, /register requires this invite code. Leave empty for open signup
# (NOT recommended in production).
INVITE_CODE=

# ---- Frontend / CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Rate limits ----
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5
SEARCH_RATE_LIMIT_PER_MINUTE=20

# ---- Backend port (host) ----
BACKEND_PORT=8000

# ---- Snusbase (primary leak-data engine) ----
# Your activation code from snusbase.com doubles as the API key (sb...).
SNUSBASE_API_KEY=
SNUSBASE_API_URL=https://api.snusbase.com

# ---- Free, keyless supplements (enrich thin email/domain results) ----
ENABLE_LEAKCHECK_PUBLIC=true
ENABLE_EMAILREP=true
ENABLE_CERTSPOTTER=true
# Optional: raises EmailRep.io rate limits (free key at https://emailrep.io/key)
EMAILREP_API_KEY=
